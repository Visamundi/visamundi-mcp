CONNECT_API_MCP_KEY=
# Optional fallback if CONNECT_API_MCP_KEY is unset
# VISAMUNDI_TOKEN=

# Optional public-route auth controls
# Set to false in production unless you intentionally run the route fully open.
# ALLOW_ANONYMOUS_PUBLIC=true
# PUBLIC_MCP_REQUIRE_API_KEY=false
#
# Optional per-integrator API key registry (KV binding required in Cloudflare).
# Keys are stored by sha256 hash. Example value:
# {"id":"demo-client"}
#
# Optional host allowlist for custom domains
# MCP_ALLOWED_HOSTS=mcp.example.com
#
# Agent application tools (form-visamundi-next /api/agent/*). Both required.
# FORM_AGENT_API_URL=http://localhost:3000
# FORM_AGENT_API_KEY=<same value as AGENT_API_KEY in form-visamundi-next .env.local>
#
# Optional deployment-only bindings:
# - PUBLIC_ROUTE_RATE_LIMITER
# - PUBLIC_GET_VISA_RATE_LIMITER
# - APPLICATION_WRITE_RATE_LIMITER
# - PUBLIC_MCP_KEYS
# - MCP_ANALYTICS
