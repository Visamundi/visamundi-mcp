	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "46b1e3d89ca646f99448d4aed9c01375"
		}
	],
	"routes": [
		{
			"pattern": "mcp.visamundi.io",
			"zone_name": "visamundi.io",
			"custom_domain": true,
			"enabled": true,
			"previews_enabled": false
		}
	],
	"limits": {
		"cpu_ms": 20000
	},
	"workers_dev": false,
	"preview_urls": false
}