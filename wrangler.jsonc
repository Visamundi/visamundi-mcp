{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "visamundi-visa-mcp",
	"main": "src/worker/index.ts",
	"compatibility_date": "2026-09-08",
	"compatibility_flags": [
		"nodejs_compat"
	],
	// Abuse controls for the public MCP route (keyed by actor: anonymous IP or public key).
	// Cloudflare only allows a 10 s or 60 s period.
	"ratelimits": [
		{
			"name": "PUBLIC_ROUTE_RATE_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 60,
				"period": 60
			}
		},
		{
			"name": "PUBLIC_GET_VISA_RATE_LIMITER",
			"namespace_id": "1002",
			"simple": {
				"limit": 10,
				"period": 60
			}
		},
		{
			// save_application + get_payment_link (anonymous writes into form-visamundi-next).
			"name": "APPLICATION_WRITE_RATE_LIMITER",
			"namespace_id": "1003",
			"simple": {
				"limit": 10,
				"period": 60
			}
		}
	],
	// "kv_namespaces": [
	// 	{
	// 		"binding": "PUBLIC_MCP_KEYS",
	// 		"id": "<PUBLIC_MCP_KEYS_KV_ID>"
	// 	}
	// ],
	// "analytics_engine_datasets": [
	// 	{
	// 		"binding": "MCP_ANALYTICS",
	// 		"dataset": "visamundi_mcp_public_route"
	// 	}
	// ],
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "46b1e3d89ca646f99448d4aed9c01375"
		}
	],
	"vars": {
		"SUPABASE_URL": "https://ltnssjhpmlopbhliltys.supabase.co",
		// Public publishable key (already shipped to browsers); sent to Supabase Auth to validate user tokens.
		"SUPABASE_ANON_KEY": "sb_publishable_8E2_SJ7PXvSwLfC4-2hVbQ_LFXlLyad",
		// Agent application tools: enabled only once the FORM_AGENT_API_KEY secret is set
		// (wrangler secret put FORM_AGENT_API_KEY — same value as AGENT_API_KEY on the form).
		"FORM_AGENT_API_URL": "https://form.visamundi.app"
	},
	"routes": [
		{
			"pattern": "mcp.visamundi.io",
			"zone_name": "visamundi.io",
			"custom_domain": true,
			"enabled": true,
			"previews_enabled": false
		}
	],
	"limits": {
		"cpu_ms": 20000
	},
	"workers_dev": false,
	"preview_urls": false
}