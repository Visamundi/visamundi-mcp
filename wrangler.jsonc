{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "visamundi-visa-mcp",
	"main": "src/worker/index.ts",
	"compatibility_date": "2026-09-08",
	"compatibility_flags": [
		"nodejs_compat"
	],
