# Local stdio development token for Connect-only testing
CONNECT_API_MCP_KEY=
# Fallback name if CONNECT_API_MCP_KEY is unset
# VISAMUNDI_TOKEN=

# Hosted MCP server connection to Supabase as the dedicated mcp_reader role
MCP_SUPABASE_DB_URL=

# Optional stdio-only overrides for local testing
# DEV_MCP_CREDENTIAL_ID=
# DEV_MCP_COMPANY_ID=
# DEV_MCP_ALLOWED_TOOLS=list_visas,get_visa,list_travel_groups,get_travel_group
# CONNECT_PARTNER_NAME=

# Hosted HTTP server settings
# HOST=0.0.0.0
# PORT=3000
# MCP_ALLOWED_HOSTS=mcp.visamundi.io
# Public route: `http://0.0.0.0:3000/`
# Private route: `http://0.0.0.0:3000/partners`
