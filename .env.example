# Local stdio development token for Connect-only testing
CONNECT_API_MCP_KEY=
# Fallback name if CONNECT_API_MCP_KEY is unset
# VISAMUNDI_TOKEN=

# Local stdio connection to Supabase as the dedicated mcp_reader role
MCP_SUPABASE_DB_URL=

# Optional stdio-only overrides for local testing
# DEV_MCP_CREDENTIAL_ID=
# DEV_MCP_COMPANY_ID=
# DEV_MCP_ALLOWED_TOOLS=list_visas,get_visa,list_travel_groups,get_travel_group
# CONNECT_PARTNER_NAME=

# Cloudflare Worker local secrets belong in `.dev.vars`
# CONNECT_API_MCP_KEY=
# VISAMUNDI_TOKEN=
# MCP_ALLOWED_HOSTS=mcp.example.com
#
# Supabase access in the Worker is provided via the `HYPERDRIVE` binding
# declared in `wrangler.jsonc`.
